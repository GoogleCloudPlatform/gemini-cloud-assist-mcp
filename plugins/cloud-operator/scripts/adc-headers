# Headers helper for the plugin's MCP servers: Claude Code's headersHelper
# (.mcp.json) and Codex's http_headers_helper (~/.codex/config.toml). Prints the
# HTTP headers for one connection as a JSON object: a fresh Application Default
# Credentials access token (gcloud auth application-default print-access-token)
# and the quota project (x-goog-user-project): the ADC file's quota_project_id,
# else gcloud's billing/quota_project, else the gcloud project. Google APIs
# reject ADC user tokens without a quota project. Never prints anything but the
# headers; errors go to stderr.
#
# .mcp.json names this file without an extension, so bash runs it on macOS,
# Linux, WSL and Git Bash, and CMD on Windows finds adc-headers.cmd beside it,
# which does the same.
#
# The Developer Knowledge API key isn't handled here: Claude Code runs a
# plugin's helper without credential-like variables such as
# DEVELOPERKNOWLEDGE_API_KEY, so .mcp.json sends the key as a static header.

set -u

if ! command -v gcloud >/dev/null 2>&1; then
  echo "gcloud isn't installed or isn't on PATH: install the Google Cloud CLI, then run: gcloud auth application-default login" >&2
  exit 1
fi
# gcloud.cmd ends lines with \r\n; some shells keep the \r in $(...), so strip it to keep the JSON valid.
token="$(gcloud auth application-default print-access-token 2>/dev/null)" || token=""
token="${token%$'\r'}"
if [ -z "$token" ]; then
  echo "Couldn't get a token from \"gcloud auth application-default print-access-token\". If you haven't signed in, run: gcloud auth application-default login. Otherwise, run that command yourself to see the error." >&2
  exit 1
fi

config="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
if [ -z "${CLOUDSDK_CONFIG:-}" ] && [ -n "${APPDATA:-}" ] && [ -d "$APPDATA/gcloud" ]; then
  config="$APPDATA/gcloud" # gcloud's folder on Windows, under Git Bash
fi
adc="$config/application_default_credentials.json"
quota="$(sed -n 's/.*"quota_project_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$adc" 2>/dev/null | head -n 1)"
if [ -z "$quota" ]; then
  quota="$(gcloud config get-value billing/quota_project 2>/dev/null)"
  quota="${quota%$'\r'}"
  # Values gcloud accepts for billing/quota_project that aren't project IDs.
  case "$quota" in
    CURRENT_PROJECT | CURRENT_PROJECT_WITH_FALLBACK | LEGACY) quota="" ;;
  esac
fi
if [ -z "$quota" ]; then
  quota="$(gcloud config get-value project 2>/dev/null)"
  quota="${quota%$'\r'}"
fi

if [ -n "$quota" ]; then
  printf '{"Authorization":"Bearer %s","x-goog-user-project":"%s"}\n' "$token" "$quota"
else
  printf '{"Authorization":"Bearer %s"}\n' "$token"
fi
